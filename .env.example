# Скопируйте в .env и подставьте свои значения. Файл .env в репозиторий не попадает.

# --- ключ ассистента -------------------------------------------------------
# Ключ авторизации GigaChat (строка Base64 из личного кабинета).
GIGACHAT_AUTH_KEY=
# Область действия ключа: GIGACHAT_API_PERS — личный, GIGACHAT_API_CORP — корпоративный.
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2-Max

# --- запасной путь: любой ассистент с OpenAI-совместимым интерфейсом --------
# Если заполнено, тетради используют его вместо GigaChat.
AI_PROVIDER_URL=
AI_PROVIDER_TOKEN=
AI_PROVIDER_MODEL=

# --- стенд -----------------------------------------------------------------
PGHOST=localhost
PGPORT=5433
PGDATABASE=bank_training
PGUSER=bank_user
PGPASSWORD=bank_pass

MB_URL=http://localhost:3000
MB_USER=workshop@example.local
MB_PASS=WorkshopBI2026!
