/**
 * Активация карт: чистка выгрузки и сводная по каналам.
 *
 * Эталонный вариант скрипта для Google Таблиц. Открывается через
 * «Расширения → Apps Script», запускается функция obrabotatVygruzku.
 *
 * Лист «Выгрузка» должен содержать таблицу с заголовками в первой строке.
 * Результат: очищенный лист «Выгрузка» с добавленным столбцом активации,
 * лист «Активация» со сводными таблицами и столбчатой диаграммой.
 */

// Порядок столбцов исходной выгрузки (нумерация массива — с нуля).
var СТОЛБЕЦ = {
  id: 0, выдача: 1, канал: 2, тариф: 3, регион: 4,
  лимит: 5, покупка: 6, оборот30: 7, оборот90: 8, статус: 9
};

var КАНАЛЫ = [
  { имя: 'Отделение',            маски: ['отделение', 'офис банка'] },
  { имя: 'Мобильное приложение', маски: ['мобильное приложение', 'мобильный банк', 'мп'] },
  { имя: 'Сайт банка',           маски: ['сайт банка', 'веб-сайт', 'вебсайт'] },
  { имя: 'Партнёрская сеть',     маски: ['партнерская сеть', 'партнер'] }
];

/** Точка входа. */
function obrabotatVygruzku() {
  var книга = SpreadsheetApp.getActiveSpreadsheet();
  var лист = книга.getSheetByName('Выгрузка');
  if (!лист) throw new Error('Нет листа «Выгрузка».');

  // Читаем всё одним вызовом: обращение к ячейкам по одной не укладывается в лимит.
  var данные = лист.getDataRange().getValues();
  var заголовки = данные[0];
  var строки = данные.slice(1);

  var очищенные = очиститьСтроки(строки);
  var итог = [заголовки.concat(['Активация за 30 дней'])].concat(очищенные);

  лист.clearContents();
  лист.getRange(1, 1, итог.length, итог[0].length).setValues(итог);

  var поКаналам = свести(очищенные, СТОЛБЕЦ.канал);
  var поТарифам = свести(очищенные, СТОЛБЕЦ.тариф);

  var сводка = книга.getSheetByName('Активация') || книга.insertSheet('Активация');
  сводка.clear();
  var блок = [['Канал оформления', 'Карт', 'Активировано', 'Доля активации, %']]
    .concat(поКаналам)
    .concat([['', '', '', ''], ['Тарифный план', 'Карт', 'Активировано', 'Доля активации, %']])
    .concat(поТарифам);
  сводка.getRange(1, 1, блок.length, 4).setValues(блок);
  сводка.getRange(1, 1, 1, 4).setFontWeight('bold');
  сводка.getRange(поКаналам.length + 3, 1, 1, 4).setFontWeight('bold');

  сводка.getCharts().forEach(function (c) { сводка.removeChart(c); });
  var диаграмма = сводка.newChart()
    .asColumnChart()
    .addRange(сводка.getRange(1, 1, поКаналам.length + 1, 1))
    .addRange(сводка.getRange(1, 4, поКаналам.length + 1, 1))
    .setOption('title', 'Доля активации по каналам оформления, %')
    .setOption('legend', { position: 'none' })
    .setPosition(2, 6, 0, 0)
    .build();
  сводка.insertChart(диаграмма);
}

/** Убирает повторы, приводит значения к нужным типам, считает признак активации. */
function очиститьСтроки(строки) {
  var виденные = {};
  var результат = [];

  for (var i = 0; i < строки.length; i++) {
    var строка = строки[i];
    if (!строка[СТОЛБЕЦ.id]) continue;

    // Ключ повтора считаем по исходным значениям — до любых преобразований.
    var ключ = строка.join('');
    if (виденные[ключ]) continue;
    виденные[ключ] = true;

    var выдача = разобратьДату(строка[СТОЛБЕЦ.выдача]);
    var покупка = разобратьДату(строка[СТОЛБЕЦ.покупка]);
    var новая = строка.slice();
    новая[СТОЛБЕЦ.выдача] = выдача;
    новая[СТОЛБЕЦ.покупка] = покупка;
    новая[СТОЛБЕЦ.канал] = нормализоватьКанал(строка[СТОЛБЕЦ.канал]);
    новая[СТОЛБЕЦ.лимит] = разобратьЧисло(строка[СТОЛБЕЦ.лимит]);
    новая[СТОЛБЕЦ.оборот30] = разобратьЧисло(строка[СТОЛБЕЦ.оборот30]);
    новая[СТОЛБЕЦ.оборот90] = разобратьЧисло(строка[СТОЛБЕЦ.оборот90]);
    новая.push(признакАктивации(выдача, покупка));
    результат.push(новая);
  }
  return результат;
}

/** «ОТДЕЛЕНИЕ », «Офис банка» и подобное — к одному из четырёх значений. */
function нормализоватьКанал(значение) {
  var текст = String(значение == null ? '' : значение)
    .trim().toLowerCase().replace(/ё/g, 'е').replace(/\s+/g, ' ');
  for (var i = 0; i < КАНАЛЫ.length; i++) {
    for (var j = 0; j < КАНАЛЫ[i].маски.length; j++) {
      if (текст.indexOf(КАНАЛЫ[i].маски[j]) === 0) return КАНАЛЫ[i].имя;
    }
  }
  return 'Прочее';
}

/** Понимает 15.03.2025 и 2025-03-15; пустое и «н/д» дают null. */
function разобратьДату(значение) {
  if (значение instanceof Date) return значение;
  var текст = String(значение == null ? '' : значение).trim();
  if (!текст || текст.toLowerCase() === 'н/д') return null;

  var точки = текст.match(/^(\d{2})\.(\d{2})\.(\d{4})$/);
  if (точки) return new Date(Number(точки[3]), Number(точки[2]) - 1, Number(точки[1]));

  var дефисы = текст.match(/^(\d{4})-(\d{2})-(\d{2})$/);
  if (дефисы) return new Date(Number(дефисы[1]), Number(дефисы[2]) - 1, Number(дефисы[3]));

  return null;
}

/** «12 000», «12000,50», «12000.5» — к числу; пустое даёт null. */
function разобратьЧисло(значение) {
  if (typeof значение === 'number') return значение;
  var текст = String(значение == null ? '' : значение).trim();
  if (!текст || текст.toLowerCase() === 'н/д') return null;
  текст = текст.replace(/[\s ]/g, '').replace(',', '.');
  var число = Number(текст);
  return isNaN(число) ? null : число;
}

/** 1, если первая покупка была не позже 30 дней после выдачи. */
function признакАктивации(выдача, покупка) {
  if (!выдача || !покупка) return 0;
  var дней = Math.round((покупка.getTime() - выдача.getTime()) / 86400000);
  return дней >= 0 && дней <= 30 ? 1 : 0;
}

/** Сводная по одному признаку: карт, активировано, доля в процентах. */
function свести(строки, столбец) {
  var порядок = [];
  var счётчики = {};
  for (var i = 0; i < строки.length; i++) {
    var ключ = строки[i][столбец];
    if (!счётчики[ключ]) { счётчики[ключ] = { всего: 0, активных: 0 }; порядок.push(ключ); }
    счётчики[ключ].всего++;
    счётчики[ключ].активных += строки[i][строки[i].length - 1];
  }
  return порядок
    .map(function (ключ) {
      var c = счётчики[ключ];
      return [ключ, c.всего, c.активных, Math.round(1000 * c.активных / c.всего) / 10];
    })
    .sort(function (a, b) { return b[3] - a[3]; });
}

// Позволяет прогнать логику вне Таблиц — в Apps Script эта строка не мешает.
if (typeof module !== 'undefined') {
  module.exports = { очиститьСтроки: очиститьСтроки, нормализоватьКанал: нормализоватьКанал,
                     разобратьДату: разобратьДату, разобратьЧисло: разобратьЧисло,
                     признакАктивации: признакАктивации, свести: свести, СТОЛБЕЦ: СТОЛБЕЦ };
}
